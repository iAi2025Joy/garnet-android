
<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- NoActionBar - the web app already has its own header/branding
         (the "GARNET" wordmark + tagline), so a native Android action
         bar on top of that would just be visual clutter/duplication. -->
    <style name="Theme.Garnet" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/garnet_background</item>
        <item name="android:statusBarColor">@color/garnet_background</item>
        <item name="android:navigationBarColor">@color/garnet_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="colorPrimary">@color/garnet_accent</item>
        <item name="colorAccent">@color/garnet_accent</item>
    </style>
</resources>
